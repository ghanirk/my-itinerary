# Salin file ini menjadi .env lalu isi nilainya masing-masing

# Local dev (docker-compose) contoh:
DATABASE_URL=postgresql://postgres:root@localhost:5432/my_itineraries

# Ganti dengan random string yang panjang & rahasia (jangan pakai contoh ini di production)
JWT_SECRET=ganti-dengan-secret-key-yang-aman

JWT_EXPIRE_MINUTES=10080

# Domain frontend yang boleh akses API ini (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGINS=http://localhost:3000

# WAJIB diisi untuk fitur auto-import URL TikTok/YouTube (ekstraksi tempat via AI).
# Google Gemini dipilih karena ada free tier tanpa kartu kredit -- ambil API key
# gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Model Gemini yang dipakai untuk ekstraksi (opsional, default sudah sesuai di bawah)
GEMINI_MODEL=gemini-2.5-flash
